@font-face{font-family:"Montserrat";font-style:normal;font-weight:300;font-display:swap;src:url(../fonts/montserrat-300.woff2) format("woff2")}
@font-face{font-family:"Montserrat";font-style:normal;font-weight:400;font-display:swap;src:url(../fonts/montserrat-400.woff2) format("woff2")}
@font-face{font-family:"Montserrat";font-style:normal;font-weight:600;font-display:swap;src:url(../fonts/montserrat-600.woff2) format("woff2")}
@font-face{font-family:"Montserrat";font-style:normal;font-weight:700;font-display:swap;src:url(../fonts/montserrat-700.woff2) format("woff2")}
@font-face{font-family:"Montserrat";font-style:normal;font-weight:800;font-display:swap;src:url(../fonts/montserrat-800.woff2) format("woff2")}
@font-face{font-family:"Montserrat";font-style:normal;font-weight:900;font-display:swap;src:url(../fonts/montserrat-900.woff2) format("woff2")}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;font-family:"Montserrat","Helvetica Neue",Arial,sans-serif;color:#0b2b36;background:#fff;font-size:16px;line-height:1.6;font-weight:400;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:#005870;text-decoration:none}
a:hover{color:#0095b4}
button{font-family:inherit}
video,iframe,img{display:block}
:focus-visible{outline:3px solid #46c3b2;outline-offset:3px;border-radius:4px}
::selection{background:#88d2e7;color:#003242}
@keyframes metPulse{70%{box-shadow:0 0 0 11px rgba(107,192,75,0)}100%{box-shadow:0 0 0 0 rgba(107,192,75,0)}}
@media (max-width:899px){.met-desk{display:none !important}}
@media (min-width:900px){.met-mob{display:none !important}}
@media (prefers-reduced-motion:reduce){*{animation-duration:.001ms !important;transition-duration:.001ms !important}html{scroll-behavior:auto}}
.h1:hover{color:#ffffff}
.h2:hover{color:#ffffff}
.h3:hover{color:#ffffff}
.h4:hover{color:#ffffff;box-shadow:0 14px 34px rgba(0,88,112,0.42)}
.h5:hover{color:#ffffff;box-shadow:0 14px 34px rgba(0,88,112,0.42)}
.h6:hover{color:#ffffff;background:rgba(255,255,255,0.1)}
.h7:hover{color:#003242;background:#88d2e7}
.h8:hover{color:#ffffff}
.h9:hover{color:#ffffff}
.h10:hover{color:#ffffff}
.h11:hover{color:#ffffff}
.h12:hover{color:#ffffff}
